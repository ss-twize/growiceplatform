# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional alias for newer Supabase projects (used when ANON key is not set)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# n8n secure webhooks
N8N_WEBHOOK_SECRET=change-me
N8N_LAUNCH_CAMPAIGN_URL=https://n8n.example.com/webhook/launch-campaign
N8N_BILLING_CREATE_LINK_URL=https://n8n.example.com/webhook/billing-create-link
N8N_BILLING_SYNC_STATUS_URL=https://n8n.example.com/webhook/billing-sync-status
